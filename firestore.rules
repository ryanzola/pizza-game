rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isAuth() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;

      // Allow users to freely read their achievements and stats and updates.
      match /achievements/{achievementId} {
        allow read: if isAuth() && request.auth.uid == userId;
        allow write: if false; // Only written by cloud functions
      }

      match /stats/{statId} {
        allow read: if isAuth() && request.auth.uid == userId;
        allow write: if false; // Only written by cloud functions
      }

      // Last server-accepted GPS fix, used by deliverOrder for teleport checks.
      match /telemetry/{docId} {
        allow read: if isAuth() && request.auth.uid == userId;
        allow write: if false; // Only written by cloud functions
      }
    }

    match /sessions/{sessionId} {
      allow create: if isAuth() && request.resource.data.user_id == request.auth.uid;
      allow read, update: if isAuth() && (resource.data.user_id == request.auth.uid);
      allow delete: if false; // Sessions shouldn't be deleted
    }

    // Geocoding cache written by Cloud Functions; never needed by clients.
    match /geocache/{docId} {
      allow read, write: if false;
    }

    match /pizzeria/{docId} {
      allow read: if isAuth();
      allow write: if false; // Only written by cloud functions
    }

    match /orders/{orderId} {
      // Allow reading queued orders or orders belonging to the user
      allow read: if isAuth() && (resource.data.user_id == null || resource.data.user_id == request.auth.uid);
      
      // Allow creating unassigned orders 
      allow create: if isAuth() && request.resource.data.user_id == null;

      // The only client-side update is claiming a queued, unassigned order
      // (status -> en_route, user_id -> me). Every other status change
      // (delivered, cancelled/expired) is made by Cloud Functions, which
      // verify location / timing server-side.
      allow update: if isAuth()
        && resource.data.user_id == null
        && resource.data.status == 'queued'
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == 'en_route'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['user_id', 'status']);

      // Allow deleting queued, unclaimed orders (simulates other drivers taking them)
      allow delete: if isAuth() && resource.data.status == 'queued' && resource.data.user_id == null;
    }
  }
}
